{
  "name": "revenuecat-webhooks",
  "version": "0.1.0",
  "description": "Typed, verified RevenueCat webhooks for Node.js, with a NestJS guard and decorator.",
  "keywords": [
    "revenuecat",
    "webhooks",
    "subscriptions",
    "in-app-purchases",
    "nestjs",
    "react-native"
  ],
  "license": "MIT",
  "author": "Harpreet Kumar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harpreetkbadhan/revenuecat-webhooks.git"
  },
  "homepage": "https://github.com/harpreetkbadhan/revenuecat-webhooks#readme",
  "bugs": "https://github.com/harpreetkbadhan/revenuecat-webhooks/issues",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "default": "./dist/nestjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/testing": "^12.6.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
